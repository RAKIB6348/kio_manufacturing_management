<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <template id="report_serial_box_label">
        <t t-call="web.html_container">
            <style>
                html, body {
                    margin: 0;
                    padding: 0;
                }
                .box_page {
                    width: 44.75cm;
                    height: 40.05cm;
                    margin: 0;
                    padding: 0;
                    overflow: hidden;
                    page-break-after: always;
                    background: #fff;
                    color: #000;
                    font-family: Arial, sans-serif;
                }
                .box_label_table {
                    width: 44.75cm;
                    height: 40.05cm;
                    border-collapse: separate;
                    border-spacing: 1.5mm 1.5mm;
                    table-layout: fixed;
                    margin: 0;
                    padding: 0;
                }
                .box_label_cell {
                    width: 11cm;
                    height: 6.5cm;
                    min-width: 11cm;
                    max-width: 11cm;
                    min-height: 6.5cm;
                    max-height: 6.5cm;
                    padding: 0;
                    margin: 0;
                    vertical-align: top;
                    box-sizing: border-box;
                    overflow: hidden;
                }
                .box_label {
                    width: 11cm;
                    height: 6.5cm;
                    border: 1px solid #000;
                    box-sizing: border-box;
                    overflow: hidden;
                    padding: 1.5mm;
                    margin: 0;
                    position: relative;
                }
                .kio_box_info {
                    position: absolute;
                    left: 2.2mm;
                    top: 2.2mm;
                    font-size: 8.2pt;
                    line-height: 1.18;
                    width: 66mm;
                }
                .kio_box_info_line {
                    white-space: nowrap;
                    overflow: hidden;
                    text-overflow: ellipsis;
                }
                .kio_box_info_label {
                    display: inline-block;
                    width: 13mm;
                    font-weight: 700;
                }
                .kio_box_barcode_title {
                    position: absolute;
                    left: 2.2mm;
                    top: 22mm;
                    font-size: 8pt;
                    font-weight: 700;
                }
                .kio_box_barcode {
                    position: absolute;
                    left: 2.2mm;
                    top: 26mm;
                    width: 64mm;
                    text-align: left;
                }
                .kio_box_serial {
                    position: absolute;
                    left: 2.2mm;
                    top: 43mm;
                    width: 64mm;
                    font-size: 8.4pt;
                    font-weight: 700;
                    line-height: 1;
                    text-align: center;
                    white-space: nowrap;
                    overflow: hidden;
                    text-overflow: ellipsis;
                }
                .kio_box_image_label {
                    position: absolute;
                    left: 70mm;
                    top: 22mm;
                    font-size: 8pt;
                    font-weight: 700;
                }
                .kio_box_image_area {
                    position: absolute;
                    left: 70mm;
                    right: 2.2mm;
                    bottom: 2.2mm;
                    height: 36mm;
                    text-align: center;
                    overflow: hidden;
                }
                .kio_box_image {
                    max-width: 100%;
                    max-height: 36mm;
                    object-fit: contain;
                }
                .box_last_page {
                    page-break-after: auto;
                }
            </style>
            <t t-set="box_columns" t-value="4"/>
            <t t-set="box_rows" t-value="6"/>
            <t t-set="box_labels_per_page" t-value="box_columns * box_rows"/>
            <t t-set="box_page_count" t-value="(len(docs) + box_labels_per_page - 1) // box_labels_per_page"/>
            <t t-foreach="range(box_page_count)" t-as="page_index">
                <div t-att-class="'page box_page' + (page_index + 1 == box_page_count and ' box_last_page' or '')">
                    <table class="box_label_table">
                        <tbody>
                            <t t-foreach="range(box_rows)" t-as="row_index">
                                <tr>
                                    <t t-foreach="range(box_columns)" t-as="column_index">
                                        <t t-set="serial_index" t-value="page_index * box_labels_per_page + row_index * box_columns + column_index"/>
                                        <td class="box_label_cell">
                                            <t t-if="serial_index &lt; len(docs)">
                                                <t t-set="serial" t-value="docs[serial_index]"/>
                                                <t t-set="product_image" t-value="serial._get_label_product_image()"/>
                                                <div class="box_label">
                                                    <div class="kio_box_info">
                                                        <div class="kio_box_info_line">
                                                            <span class="kio_box_info_label">Name</span><span>: </span><span t-out="serial._get_label_product_display_name()"/>
                                                        </div>
                                                        <div class="kio_box_info_line">
                                                            <span class="kio_box_info_label">Color</span><span>: </span><span t-out="serial._get_label_product_color()"/>
                                                        </div>
                                                        <div class="kio_box_info_line">
                                                            <span class="kio_box_info_label">Size</span><span>: </span><span t-out="serial._get_label_product_size()"/>
                                                        </div>
                                                        <div class="kio_box_info_line">
                                                            <span class="kio_box_info_label">Code</span><span>: </span><span t-out="serial._get_label_product_code()"/>
                                                        </div>
                                                        <div class="kio_box_info_line">
                                                            <span class="kio_box_info_label">MRP</span><span>: </span><span t-out="serial._get_label_product_mrp()"/>
                                                        </div>
                                                    </div>
                                                    <div class="kio_box_barcode_title">BarCode:</div>
                                                    <div class="kio_box_barcode">
                                                        <div t-out="serial._get_label_barcode_value()"
                                                             t-options="{'widget': 'barcode', 'symbology': 'Code128', 'img_style': 'width:62mm;height:16mm'}"/>
                                                    </div>
                                                    <div class="kio_box_serial" t-out="serial._get_label_barcode_value()"/>
                                                    <div class="kio_box_image_label">Shoe Pic:</div>
                                                    <div class="kio_box_image_area">
                                                        <img t-if="product_image"
                                                             t-att-src="image_data_uri(product_image)"
                                                             class="kio_box_image"
                                                             alt="Shoe Pic"/>
                                                    </div>
                                                </div>
                                            </t>
                                        </td>
                                    </t>
                                </tr>
                            </t>
                        </tbody>
                    </table>
                </div>
            </t>
        </t>
    </template>
</odoo>
