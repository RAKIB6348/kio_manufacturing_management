<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <template id="report_serial_shoe_label">
        <t t-call="web.html_container">
            <style>
                html, body {
                    margin: 0;
                    padding: 0;
                }
                .kio_shoe_label_page {
                    width: 40mm;
                    height: 35mm;
                    box-sizing: border-box;
                    overflow: hidden;
                    page-break-after: always;
                    page-break-inside: avoid;
                    break-inside: avoid;
                    background: #fff;
                    color: #000;
                    font-family: Arial, sans-serif;
                }
                .kio_shoe_label {
                    width: 40mm;
                    height: 35mm;
                    box-sizing: border-box;
                    overflow: hidden;
                    border: 1px solid #000;
                    padding: 0.8mm;
                    page-break-inside: avoid;
                    break-inside: avoid;
                }
                .kio_shoe_info {
                    font-size: 5.4pt;
                    line-height: 1;
                    white-space: nowrap;
                    overflow: hidden;
                    text-overflow: ellipsis;
                }
                .kio_shoe_info_line {
                    white-space: nowrap;
                    overflow: hidden;
                    text-overflow: ellipsis;
                }
                .kio_shoe_info_label {
                    font-weight: 700;
                }
                .kio_shoe_barcode {
                    margin-top: 0.8mm;
                    text-align: center;
                }
                .kio_shoe_serial {
                    margin-top: 0.4mm;
                    font-size: 5.8pt;
                    line-height: 1;
                    text-align: center;
                    font-weight: 700;
                    white-space: nowrap;
                    overflow: hidden;
                    text-overflow: ellipsis;
                }
                .kio_shoe_last_page {
                    page-break-after: auto;
                }
            </style>
            <t t-foreach="docs" t-as="serial">
                <div t-att-class="'kio_shoe_label_page' + (serial_last and ' kio_shoe_last_page' or '')">
                    <div class="kio_shoe_label">
                        <div class="kio_shoe_info">
                            <div class="kio_shoe_info_line">
                                <span class="kio_shoe_info_label">Name: </span><span t-out="serial._get_label_product_display_name()"/>
                            </div>
                            <div class="kio_shoe_info_line">
                                <span class="kio_shoe_info_label">Size: </span><span t-out="serial._get_label_product_size()"/>
                            </div>
                            <div class="kio_shoe_info_line">
                                <span class="kio_shoe_info_label">Code: </span><span t-out="serial._get_label_product_code()"/>
                            </div>
                            <div class="kio_shoe_info_line">
                                <span class="kio_shoe_info_label">MRP: </span><span t-out="serial._get_label_product_mrp()"/>
                            </div>
                        </div>
                        <div class="kio_shoe_barcode">
                            <div t-out="serial._get_label_barcode_value()"
                                 t-options="{'widget': 'barcode', 'symbology': 'Code128', 'img_style': 'width:38mm;height:11mm'}"/>
                        </div>
                        <div class="kio_shoe_serial" t-out="serial._get_label_barcode_value()"/>
                    </div>
                </div>
            </t>
        </t>
    </template>
</odoo>
