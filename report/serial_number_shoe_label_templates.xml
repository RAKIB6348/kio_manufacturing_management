<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <template id="report_serial_shoe_label">
        <t t-call="web.html_container">
            <style>
    html,
    body,
    main,
    article {
        margin: 0 !important;
        padding: 0 !important;
    }
    table,
    tr,
    td {
        page-break-inside: avoid !important;
        break-inside: avoid !important;
    }
    .shoe_page {
        width: 170mm;
        height: 224mm;
        margin: 0;
        padding: 0;
        overflow: hidden !important;
        page-break-inside: avoid !important;
        break-inside: avoid !important;
        page-break-after: auto !important;
        background: #fff;
        color: #000;
        font-family: Arial, sans-serif;
        display: flex;
        align-items: center;
        justify-content: center;
    }
    .shoe_page:not(.shoe_last_page) {
        page-break-after: always !important;
    }
    .shoe_last_page {
        page-break-after: auto !important;
    }
    .shoe_label_table {
        width: 170mm;
        height: 224mm;
        border-collapse: separate;
        border-spacing: 2mm 2mm;
        table-layout: fixed;
        margin: 0;
        padding: 0;
    }
    .shoe_label_table tr {
        height: 35mm;
        page-break-inside: avoid !important;
        break-inside: avoid !important;
    }
    .shoe_label_cell {
        width: 40mm;
        height: 35mm;
        min-width: 40mm;
        max-width: 40mm;
        min-height: 35mm;
        max-height: 35mm;
        padding: 0;
        margin: 0;
        vertical-align: top;
        box-sizing: border-box;
        overflow: hidden;
        page-break-inside: avoid !important;
        break-inside: avoid !important;
    }
    .shoe_label {
        width: 40mm;
        height: 35mm;
        border: 0.3mm solid #000;
        box-sizing: border-box;
        overflow: hidden;
        padding: 1mm;
        margin: 0;
        background: #fff;
        display: flex;
        flex-direction: column;
    }
    .kio_shoe_info {
        font-size: 6pt;
        line-height: 1.1;
        white-space: nowrap;
        overflow: hidden;
        text-overflow: ellipsis;
    }
    .kio_shoe_info_line {
        white-space: nowrap;
        overflow: hidden;
        text-overflow: ellipsis;
        margin-bottom: 0.3mm;
    }
    .kio_shoe_info_label {
        font-weight: 700;
    }
    .kio_shoe_barcode {
        width: 100%;
        margin-top: 1.5mm;
        padding: 0;
        box-sizing: border-box;
        text-align: center;
        background: #fff;
        overflow: visible;
        flex-grow: 1;
        display: flex;
        flex-direction: column;
        justify-content: flex-end;
    }
    .kio_shoe_barcode img {
        display: block !important;
        width: 38mm !important;
        height: 12mm !important;
        max-width: none !important;
        margin: 0 auto !important;
        background: #fff;
    }
    .kio_shoe_serial {
        margin-top: 0.5mm;
        font-size: 5.5pt;
        line-height: 1;
        text-align: center;
        font-weight: 700;
        white-space: nowrap;
        overflow: hidden;
        text-overflow: ellipsis;
    }

</style>
            <t t-set="shoe_columns" t-value="4"/>
            <t t-set="shoe_rows" t-value="6"/>
            <t t-set="shoe_labels_per_page" t-value="shoe_columns * shoe_rows"/>
            <t t-set="shoe_page_count" t-value="(len(docs) + shoe_labels_per_page - 1) // shoe_labels_per_page"/>
            <t t-foreach="range(shoe_page_count)" t-as="page_index">
                <div t-att-class="'shoe_page' + (' shoe_last_page' if page_index + 1 == shoe_page_count else '')">
                    <table class="shoe_label_table">
                        <tbody>
                            <t t-foreach="range(shoe_rows)" t-as="row_index">
                                <tr>
                                    <t t-foreach="range(shoe_columns)" t-as="column_index">
                                        <t t-set="serial_index" t-value="page_index * shoe_labels_per_page + row_index * shoe_columns + column_index"/>
                                        <td class="shoe_label_cell">
                                            <t t-if="serial_index &lt; len(docs)">
                                                <t t-set="serial" t-value="docs[serial_index]"/>
                                                <t t-set="barcode_value" t-value="serial._get_label_barcode_value() or ''"/>
                                                <div class="shoe_label">
                                                    <div class="kio_shoe_info">
                                                        <div class="kio_shoe_info_line">
                                                            <span class="kio_shoe_info_label">Name: </span><span t-out="serial._get_label_product_display_name()"/>
                                                        </div>
                                                        <div class="kio_shoe_info_line">
                                                            <span class="kio_shoe_info_label">Size: </span><span t-out="serial._get_label_product_size()"/>
                                                        </div>
                                                        <div class="kio_shoe_info_line">
                                                            <span class="kio_shoe_info_label">Code: </span><span t-out="serial._get_label_product_code()"/>
                                                        </div>
                                                        <div class="kio_shoe_info_line">
                                                            <span class="kio_shoe_info_label">MRP: </span><span t-out="serial._get_label_product_mrp()"/>
                                                        </div>
                                                    </div>
                                                    <t t-if="barcode_value">
                                                        <div class="kio_shoe_barcode">
                                                            <div t-out="barcode_value"
                                                                 style="padding:0"
                                                                 t-options="{'widget': 'barcode', 'symbology': 'Code128Auto', 'width': 950, 'height': 300, 'quiet': 1, 'img_style': 'display:block;width:38mm;height:12mm;margin:0 auto;'}"/>
                                                        </div>
                                                        <div class="kio_shoe_serial" t-out="barcode_value"/>
                                                    </t>
                                                </div>
                                            </t>
                                        </td>
                                    </t>
                                </tr>
                            </t>
                        </tbody>
                    </table>
                </div>
            </t>
        </t>
    </template>
</odoo>
