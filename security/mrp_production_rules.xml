<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="rule_mrp_production_manager_draft_only" model="ir.rule">
        <field name="name">KIO MO Manager: Draft and Request for Approval Only</field>
        <field name="model_id" ref="mrp.model_mrp_production"/>
        <field name="domain_force">[('state', 'in', ('draft', 'request_approval_mo'))]</field>
        <field name="groups" eval="[(4, ref('kio_purchase_management.group_kio_purchase_manager'))]"/>
        <field name="perm_read" eval="True"/>
        <field name="perm_write" eval="True"/>
        <field name="perm_create" eval="True"/>
        <field name="perm_unlink" eval="False"/>
    </record>

    <record id="rule_mrp_production_ceo_approval_only" model="ir.rule">
        <field name="name">KIO MO COO: Request for Approval, Rejected, and Confirmed Only</field>
        <field name="model_id" ref="mrp.model_mrp_production"/>
        <field name="domain_force">[('state', 'in', ('request_approval_mo', 'rejected', 'confirmed'))]</field>
        <field name="groups" eval="[(4, ref('kio_purchase_management.group_kio_purchase_ceo'))]"/>
        <field name="perm_read" eval="True"/>
        <field name="perm_write" eval="True"/>
        <field name="perm_create" eval="False"/>
        <field name="perm_unlink" eval="False"/>
    </record>

    <record id="rule_mrp_production_ceo_draft_write_for_confirm" model="ir.rule">
        <field name="name">KIO MO COO: Draft Write for Confirm</field>
        <field name="model_id" ref="mrp.model_mrp_production"/>
        <field name="domain_force">[('state', '=', 'draft')]</field>
        <field name="groups" eval="[(4, ref('kio_purchase_management.group_kio_purchase_ceo'))]"/>
        <field name="perm_read" eval="False"/>
        <field name="perm_write" eval="True"/>
        <field name="perm_create" eval="False"/>
        <field name="perm_unlink" eval="False"/>
    </record>

    <record id="rule_mrp_production_head_of_factory_confirmed_only" model="ir.rule">
        <field name="name">KIO MO Head of Factory: Production Action States Only</field>
        <field name="model_id" ref="mrp.model_mrp_production"/>
        <field name="domain_force">[('state', 'in', ('confirmed', 'progress', 'to_close', 'done', 'cancel'))]</field>
        <field name="groups" eval="[(4, ref('kio_purchase_management.group_kio_purchase_head_of_factory'))]"/>
        <field name="perm_read" eval="True"/>
        <field name="perm_write" eval="True"/>
        <field name="perm_create" eval="False"/>
        <field name="perm_unlink" eval="False"/>
    </record>

    <record id="rule_mrp_production_admin_all" model="ir.rule">
        <field name="name">KIO MO Admin: All Manufacturing Orders</field>
        <field name="model_id" ref="mrp.model_mrp_production"/>
        <field name="domain_force">[(1, '=', 1)]</field>
        <field name="groups" eval="[(4, ref('kio_purchase_management.group_kio_purchase_admin'))]"/>
        <field name="perm_read" eval="True"/>
        <field name="perm_write" eval="True"/>
        <field name="perm_create" eval="True"/>
        <field name="perm_unlink" eval="True"/>
    </record>
</odoo>
